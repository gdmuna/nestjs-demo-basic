#!/bin/sh

GREEN="\033[32m"; YELLOW="\033[33m"; RESET="\033[0m"

log()  { printf "%-12b  %b\n" "${GREEN}[GitHook]" "[LOG] $1${RESET}"; }
warn() { printf "%-12b  %b\n" "${YELLOW}[GitHook]" "[WARN] $1${RESET}"; }

log "执行 Pre-commit hook"

# 记录已暂存的 env 文件（排除 .env.example）
staged_env_files=$(git diff --cached --name-only -- ':**/.env.*' ':!**/.env.example' ':!**/.env.*.local')

# 如果有暂存的 env 文件，先加密它们
if [ -n "$staged_env_files" ]; then
    # 加密环境变量，以防忘记加密
    pnpm dotenvx encrypt -f $staged_env_files
    git add $staged_env_files
fi

if git diff --cached --quiet; then
    warn "无暂存文件，跳出 Pre-commit hooks"
    exit 0
fi

log "执行 lint-staged"

pnpm lint-staged

log "执行 lint-staged 完毕"

log "Pre-commit hooks 执行完毕"
exit 0

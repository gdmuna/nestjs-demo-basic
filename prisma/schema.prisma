generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  username     String     @unique
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(USER_DEFAULT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  bannedUntil  DateTime?
  bannedReason String?

  profile       UserProfile?
  statusHistory UserStatusHistory[]
  files         File[]
}

enum UserRole {
  ADMIN
  USER_DEFAULT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

model UserProfile {
  userId     String          @id @default(uuid(7)) @db.Uuid
  nickname   String?
  avatarId   String?         @db.Uuid
  bio        String?
  sex        UserProfileSex?
  sexVisible Boolean         @default(true)
  birthday   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  user   User  @relation(fields: [userId], references: [id])
  avatar File? @relation(fields: [avatarId], references: [id])
}

enum UserProfileSex {
  MALE
  FEMALE
  OTHER // wtf???
}

model UserStatusHistory {
  id           String                 @id @default(uuid(7)) @db.Uuid
  userId       String                 @db.Uuid
  operatorType UserStatusOperatorType
  operatorId   String?
  fromStatus   UserStatus
  toStatus     UserStatus
  remark       String?
  createdAt    DateTime               @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum UserStatusOperatorType {
  SYSTEM
  MANUAL
}

model File {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @db.Uuid
  domain     FileDomain
  bucket     String
  bucketType BucketType
  bucketKey  String
  visibility FileVisibility
  filename   String
  mimeType   String
  status     FileStatus     @default(PENDING)
  size       Int?
  checksum   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  user          User          @relation(fields: [userId], references: [id])
  profileAvatar UserProfile[]

  @@index([userId])
  @@index([status, createdAt])
}

enum FileDomain {
  USER_PROFILE_IMAGE
  USER_POST_ATTACHMENT
  USER_POST_DOCUMENT
  USER_POST_IMAGE
  USER_POST_VIDEO
  USER_COMMENT_IMAGE
  USER_COMMENT_VIDEO
  USER_TODO_ATTACHMENT
  USER_TODO_DOCUMENT
  USER_TODO_IMAGE
  USER_TODO_VIDEO
}

enum BucketType {
  PUBLIC
  PRIVATE
  STAGING
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum FileStatus {
  PENDING
  ACTIVE
  DELETED
}

{
  "name": "nestjs-scaffold",
  "private": true,
  "version": "0.7.4",
  "description": "一个使用 NestJS 构建的示例项目",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "db:gen-client": "prisma generate",
    "db:studio": "prisma studio -b none",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "build": "nest build && tsc-alias -v",
    "start:local": "dotenvx run -f secrets/env/.env.local -- nest start --watch --exec \"pnpm tsc-alias -v && node dist/src/main\"",
    "start:dev": "dotenvx run -f secrets/env/.env.development -- nest start --watch --exec \"pnpm tsc-alias -v && node dist/src/main\"",
    "start:prod": "pnpm build && dotenvx run -f secrets/env/.env.production -- node dist/src/main",
    "test": "dotenvx run -f secrets/env/.env.test -- vitest run",
    "test:watch": "dotenvx run -f secrets/env/.env.test -- vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:encrypt": "dotenvx encrypt -f secrets/env/.env.development secrets/env/.env.test secrets/env/.env.production",
    "env:decrypt": "dotenvx decrypt -f secrets/env/.env.development secrets/env/.env.test secrets/env/.env.production",
    "prepare": "husky",
    "docs:gen-reference": "tsx scripts/generate-error-reference.ts",
    "docs:gen-openapi": "dotenvx run -f secrets/env/.env.development -- tsx scripts/generate-openapi.ts",
    "docs:dev": "pnpm docs:gen-reference && dotenvx run -f secrets/env/.env.development -- pnpm --filter website dev",
    "docs:build": "pnpm docs:gen-reference && pnpm --filter website build",
    "docs:serve": "pnpm --filter website serve",
    "prisma": "tsx scripts/prisma.ts",
    "dotenvx": "dotenvx"
  },
  "keywords": [],
  "author": "Maiturin",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/lib-storage": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@dotenvx/dotenvx-ops": "^0.48.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@keyv/valkey": "^1.0.11",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-fastify": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/nestjs-api-reference": "^1.1.19",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.8",
    "fastify": "^5.8.5",
    "figlet": "^1.11.0",
    "gradient-string": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.24",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
